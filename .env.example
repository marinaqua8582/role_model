# GEMINI_API_KEY: Optional if using direct server-side Gemini features
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# VITE_GAS_URL: Google Apps Script Web App URL for student client-side integration
VITE_GAS_URL="https://script.google.com/macros/s/AKfycbzmtB28cj27SglDkQepd1DGlRRrv57LIRLipACLXRS1rSSiT0fPVtdrcNebKFg9X3nl/exec"

# GAS_URL: Server-side Google Apps Script Web App URL for admin operations
GAS_URL="https://script.google.com/macros/s/AKfycbzmtB28cj27SglDkQepd1DGlRRrv57LIRLipACLXRS1rSSiT0fPVtdrcNebKFg9X3nl/exec"

# ADMIN_PASSWORD: Required teacher admin login password (Server-only, no default fallback in production)
ADMIN_PASSWORD="admin"

# ADMIN_API_SECRET: Secret shared strictly between Server and Google Apps Script Script Properties
ADMIN_API_SECRET="my_secure_admin_secret_token"
