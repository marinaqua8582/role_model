{
  "buildCommand": "npm run lint && npm test && node tests/deployment-connection.cjs && npm run build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/gas-proxy.ts": {
      "maxDuration": 90
    },
    "api/staging-performance.ts": {
      "maxDuration": 90
    }
  },
  "git": {
    "deploymentEnabled": {
      "handoff-20261012-evening": false,
      "integration-20261012-concurrency": false
    }
  }
}
